        <mxCell id="whhAsOE7O7vKOtboE39M-1" value="The RFFC synthesises a local oscillator and mixes it with the incoming &#xa;signal, yielding sum &amp;amp; difference frequencies, as is normal in RF &#xa;frequency conversion. The MAX chip then selects one or both of the &#xa;sum&amp;amp;difference frequencies, depending on what falls into its tuning &#xa;range.&lt;span class=&quot;timestamp-3ZCmNB timestampInline-yHQ6fX&quot;&gt;&lt;time&gt;&lt;/time&gt;&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="455.62" y="3810" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="FBHfoe3ZZGi-QwIY5l5V-1" value="" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="3310" width="2190" height="1700" as="geometry" />
        </mxCell>
        <mxCell id="FBHfoe3ZZGi-QwIY5l5V-4" value="&lt;h1&gt;Analisa pada MAX2387&lt;br&gt;&lt;/h1&gt;&lt;p&gt;Penjelasan mengenai kerja MAX2387 pada Transmitter dan Receiver HackRF&lt;br&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="4125.29" y="2.2699999999999996" width="390" height="100" as="geometry" />
        </mxCell>
        <mxCell id="FBHfoe3ZZGi-QwIY5l5V-6" value="&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 48px&quot;&gt;1&lt;/font&gt;&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;align=center;fillColor=#FF0000;" parent="1" vertex="1">
          <mxGeometry x="4125.29" y="102.27000000000001" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="FBHfoe3ZZGi-QwIY5l5V-7" value="&lt;div align=&quot;left&quot;&gt;Aktifnya atau bekerjanya MAX2837 adalah berdasarkan pada control yang aktif, dapat dijelaskan pada tabel dibawah;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;Dalam keadaan Shutdown, ENABLE 0, RXENABLE 0, TXENABLE 0&lt;/li&gt;&lt;li&gt;Keadaan Standby, 1, 0, 0&lt;/li&gt;&lt;li&gt;Keadaan Rx On, 1, 1, 0&lt;/li&gt;&lt;li&gt;Keadaan Tx On, 1, 0, 1&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;pin&amp;nbsp; pin control tersebut terhubung pada microcontroller LPC yang memerintahkan dan memberikan status pada MAX2387&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="4210" y="90" width="360" height="167.73" as="geometry" />
        </mxCell>
